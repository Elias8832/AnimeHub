<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- your own anime files on the phone: Android's "All files access" (11+), plain read below -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- the VPN check before online episodes -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- ani-cli runs in the user's Termux (Decision 88) -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <queries><package android:name="com.termux" /></queries>
    <application android:label="AnimeHub" android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".TermuxResult" android:exported="false" />
    </application>
</manifest>
